# SIA Environment Configuration — LOCAL DEVELOPMENT ONLY
# -----------------------------------------------------------------------------
# Copy to .env and fill in actual values. NEVER commit .env.
# Production secrets are injected by scripts/deploy/configure.sh + K8s Secret.
# -----------------------------------------------------------------------------

# App
SIA_ENV=dev
SIA_DEBUG=false                 # set true only when actively debugging locally
SIA_LOG_LEVEL=INFO

# MySQL — must be set (no defaults shipped)
SIA_MYSQL_HOST=localhost
SIA_MYSQL_PORT=3306
SIA_MYSQL_USER=sia
SIA_MYSQL_PASSWORD=             # required, generate with: openssl rand -base64 24
SIA_MYSQL_DATABASE=sia

# Redis
SIA_REDIS_HOST=localhost
SIA_REDIS_PORT=6379
SIA_REDIS_PASSWORD=             # required in prod

# Milvus
SIA_MILVUS_HOST=localhost
SIA_MILVUS_PORT=19530
SIA_MILVUS_TOKEN=

# MinIO — must be set (no defaults shipped)
SIA_MINIO_HOST=localhost
SIA_MINIO_PORT=9000
SIA_MINIO_ACCESS_KEY=           # required, generate with: openssl rand -hex 16
SIA_MINIO_SECRET_KEY=           # required, generate with: openssl rand -base64 32

# Auth — required in production
SIA_AUTH_JWT_SECRET=            # generate with: openssl rand -hex 32
SIA_AUTH_JWT_ALGORITHM=HS256    # HS256 (dev) or RS256 (prod, via configure.sh)
SIA_API_KEY=                    # generate with: openssl rand -hex 32
SIA_ADMIN_PASSWORD=             # initial admin, rotated on first login

# LLM Keys (leave empty to skip cloud providers)
SIA_ANTHROPIC_API_KEY=
SIA_GOOGLE_API_KEY=
SIA_OPENAI_API_KEY=

# Proxy for cloud LLM access (if behind a corporate firewall)
SIA_HTTPS_PROXY=

# -----------------------------------------------------------------------------
# docker-compose.yaml also reads these for the local MySQL container:
#   DEV_MYSQL_ROOT_PASSWORD      — root password for the dev container
#   DEV_MYSQL_PASSWORD           — application password (mirror SIA_MYSQL_PASSWORD)
# Export them in your shell before: docker compose up -d
# -----------------------------------------------------------------------------
DEV_MYSQL_ROOT_PASSWORD=
DEV_MYSQL_PASSWORD=
