# ==============================================================================
# SIA Frontend — Nginx Static Build (unprivileged, SEC-010)
# ==============================================================================

# ---------- Stage 1: Node build ----------
FROM node:26-alpine AS builder

WORKDIR /build
COPY web/package.json web/package-lock.json* ./
RUN npm ci --ignore-scripts

COPY web/ .
RUN npm run build
RUN mkdir -p /out && cp -r /build/../deploy/static/* /out/ 2>/dev/null || cp -r /build/dist/* /out/ 2>/dev/null || true

# ---------- Stage 2: Nginx (unprivileged — runs as UID 101, binds :8080) ----------
FROM nginxinc/nginx-unprivileged:1.27-alpine

LABEL maintainer="alex <unix_sec@163.com>" \
      org.opencontainers.image.title="sia-web" \
      org.opencontainers.image.description="Security Intelligence Agent — Frontend" \
      org.opencontainers.image.version="0.2.0" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/unixsec/Security-Intelligence-agent"

USER 0
RUN rm -rf /usr/share/nginx/html/*
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /out/ /usr/share/nginx/html/
RUN chown -R 101:101 /usr/share/nginx/html /etc/nginx/conf.d
USER 101

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1
