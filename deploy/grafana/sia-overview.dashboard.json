{
  "title": "SIA — Overview",
  "uid": "sia-overview",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["sia", "security-intelligence"],
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "prometheus" }
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${ds}" },
        "query": "label_values(http_requests_total{job=\"sia-api\"}, namespace)",
        "current": { "text": "sia", "value": "sia" }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Availability (5m)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [
        { "expr": "1 - sia:api_error_ratio:5m", "format": "time_series", "legendFormat": "" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "p95 read latency",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by(le)(rate(http_request_duration_seconds_bucket{job=\"sia-api\",method=\"GET\"}[5m])))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.2 },
              { "color": "red", "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "raw_intel_stream lag",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [
        { "expr": "sia_stream_lag{stream=\"raw_intel_stream\"}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 200 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Open circuit breakers",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [
        { "expr": "count(sia_circuit_state == 2)" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "P0 today",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "targets": [
        { "expr": "sum(increase(sia_intel_analyzed_total{priority=\"P0\"}[24h]))" }
      ]
    },
    {
      "type": "stat",
      "title": "Reports / day",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "targets": [
        { "expr": "sum(increase(sia_reports_generated_total[24h]))" }
      ]
    },
    {
      "type": "timeseries",
      "title": "API error ratio (5xx / total)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sia:api_error_ratio:5m", "legendFormat": "5m" },
        { "expr": "sia:api_error_ratio:1h", "legendFormat": "1h" },
        { "expr": "sia:api_error_ratio:6h", "legendFormat": "6h" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "type": "timeseries",
      "title": "LLM call duration (p50/p95/p99)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by(le)(rate(sia_llm_call_duration_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by(le)(rate(sia_llm_call_duration_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by(le)(rate(sia_llm_call_duration_seconds_bucket[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "type": "timeseries",
      "title": "Intel analyzed by priority",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "sum by(priority)(rate(sia_intel_analyzed_total[5m]))", "legendFormat": "{{priority}}" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Push delivery (success vs failed)",
      "datasource": { "type": "prometheus", "uid": "${ds}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum by(channel,result)(rate(sia_push_dispatch_total[5m]))", "legendFormat": "{{channel}}/{{result}}" }
      ]
    }
  ]
}
